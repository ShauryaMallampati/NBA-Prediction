# NBA Prediction Platform - Environment Variables
# Copy this file to .env and fill in the values

# NBA Stats API Configuration
# Most endpoints in nba_api don't require a key, but some higher-level scrapers might.
NBA_STATS_API_KEY=your_key_here

# Betting Odds API (e.g., The Odds API)
# Get a key from https://the-odds-api.com/
ODDS_API_KEY=your_key_here

# Optional: RapidAPI Key (for secondary schedule/odds sources)
RAPIDAPI_KEY=your_key_here

# Optional: Additional data providers
BALLDONTLIE_API_KEY=your_key_here
SPORTSDATA_API_KEY=your_key_here
HIGHLIGHTS_API_KEY=your_key_here

# Optional: Project Settings
REQUIRE_REAL_DATA=true
LOG_LEVEL=INFO

# Betting Strategy (Kelly Criterion)
BANKROLL=1000.0
# 0.25 = Quarter Kelly (recommended for risk management)
KELLY_FRACTION=0.25
# Minimum probability edge vs market (5%)
MIN_EDGE=0.05
# Maximum bankroll percentage for a single bet (5%)
MAX_BET_PCT=0.05

# Frontend API URL (if different from default)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Social + sentiment (optional)
X_BEARER_TOKEN=your_key_here
REDDIT_CLIENT_ID=your_key_here
REDDIT_CLIENT_SECRET=your_key_here
YOUTUBE_API_KEY=your_key_here

# Travel model (optional)
ORS_API_KEY=your_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
